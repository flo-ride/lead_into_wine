(
    races: [
        "orc",
        "human",
        "wizard",
        "goblin",
    ],

    // per-race tuning knobs consumed by the formula above:
    // tolerance divides the raw error before evaluation, mood_bias is added directly
    race_profiles: {
        "orc": (texture: "orc.aseprite", tolerance: 1.5, mood_bias: 0.1),
        // "elf": (texture: "warrior.aseprite", tolerance: 0.6, mood_bias: 0.0),
        "goblin": (texture: "goblin.aseprite", tolerance: 1.0, mood_bias: -0.05),
        "human": (texture: "warrior.aseprite", tolerance: 1.0, mood_bias: 0.0),
        "wizard": (texture: "wizard.aseprite", tolerance: 0.8, mood_bias: 0.0),
    },

    // named personas as a map: name -> persona data
    // preferences let a persona react differently to specific recipes
    // (tolerance_bonus stacks on top of the race's base tolerance)
