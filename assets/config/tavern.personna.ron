(
    races: [
        "orc",
        "elf",
        "dwarf",
        "human",
        "wizard",
    ],

    // per-race tuning knobs consumed by the formula above:
    // tolerance divides the raw error before evaluation, mood_bias is added directly
    race_profiles: {
        "orc": (texture: "orc.png", tolerance: 1.5, mood_bias: 0.1),
        "elf": (texture: "elf.png", tolerance: 0.6, mood_bias: 0.0),
        "dwarf": (texture: "dwarf.png", tolerance: 1.0, mood_bias: -0.05),
        "human": (texture: "human.png", tolerance: 1.0, mood_bias: 0.0),
        "wizard": (texture: "wizard.png", tolerance: 0.8, mood_bias: 0.0),
    },

    // named personas as a map: name -> persona data
    // preferences let a persona react differently to specific recipes
    // (tolerance_bonus stacks on top of the race's base tolerance)
    personas: [
        (
            name: "bob",
            race: "orc",
            texture: "knight.png",
            greetings: [
                "Hello there!",
                "What's brewing, barkeep?",
            ],
            preferences: [],
        ),
        (
            name: "bobette",
            race: "orc",
            greetings: [
                "Evening! Surprise me.",
            ],
            preferences: [],
        ),
        (
            name: "bobo",
            race: "orc",
            greetings: [
                "Bobo thirsty. Bobo wait.",
            ],
            preferences: [],
        ),
        (
            name: "elowen",
            race: "elf",
            greetings: [
                "I expect precision, bartender.",
            ],
            preferences: [],
        ),
        (
            name: "thrundir",
            race: "dwarf",
            greetings: [
                "Make it strong or don't bother.",
            ],
            preferences: [],
        ),
    ]
)
